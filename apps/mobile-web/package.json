{
  "name": "mobile-web",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start",
    "dev:ios": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --ios",
    "dev:android": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --android",
    "dev:web": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --web",
    "build": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo export -p web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "maestro test e2e/maestro/flow.yaml"
  },
  "dependencies": {
    "@repo/api-contracts": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@tanstack/react-query": "^5.51.0",
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.0",
    "nativewind": "^4.0.36",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.10",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@playwright/test": "^1.46.0",
    "@repo/config": "workspace:*",
    "@testing-library/react-native": "^12.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
