{
  "name": "mobile-web",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start",
    "dev:ios": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --ios",
    "dev:android": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --android",
    "dev:web": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --web",
    "build": "EXPO_USE_METRO_WORKSPACE_ROOT=1 expo export -p web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "maestro test e2e/maestro/flow.yaml"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "api": "workspace:*",
    "expo": "~57.0.20",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@playwright/test": "^1.63.0",
    "@repo/config": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.18",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
