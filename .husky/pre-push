pnpm install --frozen-lockfile || {
  echo "pnpm install --frozen-lockfile failed (see the pnpm output above). If it reports ERR_PNPM_OUTDATED_LOCKFILE, pnpm-lock.yaml is out of date with package.json: run 'pnpm install' and commit the update. Otherwise this is an install problem (network, registry auth, disk), not a lockfile problem." >&2
  exit 1
}
